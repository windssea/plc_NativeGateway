FUNCTION NG_SafeAdd : ULINT
VAR_INPUT
    CounterValue : ULINT;
    Delta : ULINT;
END_VAR
IF CounterValue>=ULINT#9007199254740991 THEN NG_SafeAdd:=ULINT#9007199254740991; RETURN; END_IF;
IF Delta>ULINT#9007199254740991-CounterValue THEN
    NG_SafeAdd := ULINT#9007199254740991;
ELSE NG_SafeAdd := CounterValue+Delta;
END_IF;
END_FUNCTION
