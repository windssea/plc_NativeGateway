FUNCTION NG_UiText : NG_UiLabel
VAR_INPUT
    Value : NG_Text;
    English : BOOL;
END_VAR
NG_UiText:=TO_WSTRING(Value,"");
IF English THEN
IF Value='PERSISTED' THEN NG_UiText:="Saved · no changes";
ELSIF Value='UNSAVED DRAFT' THEN NG_UiText:="Unapplied changes";
ELSIF Value='VERSION CONFLICT' THEN NG_UiText:="Configuration changed";
ELSIF Value='CONNECTED' THEN NG_UiText:="Connected";
ELSIF Value='CONNECTING' THEN NG_UiText:="Connecting";
ELSIF Value='HUB_MANAGED' THEN NG_UiText:="Hub managed";
ELSIF Value='STANDALONE' THEN NG_UiText:="Standalone";
ELSIF Value='holding_register' THEN NG_UiText:="Holding register";
ELSIF Value='input_register' THEN NG_UiText:="Input register";
ELSIF Value='discrete_input' THEN NG_UiText:="Discrete input";
ELSIF Value='cyclic' THEN NG_UiText:="Cyclic";
ELSIF Value='change' THEN NG_UiText:="On change";
ELSIF Value='change_or_cyclic' THEN NG_UiText:="Change or cyclic";
ELSIF Value='Startup identity persisted; MQTT starting.' THEN NG_UiText:="Saved configuration restored automatically. No need to save again.";
ELSIF Value='true' THEN NG_UiText:="Enabled";
ELSIF Value='TRUE' THEN NG_UiText:="Enabled";
ELSIF Value='false' THEN NG_UiText:="Disabled";
ELSIF Value='FALSE' THEN NG_UiText:="Disabled";
ELSIF Value='HUB_MANAGED - local device/point changes blocked' THEN NG_UiText:="Managed by Hub: edit and publish devices, points and periods in Hub. Connection maintenance is available here.";
ELSIF Value='STANDALONE - local maintenance enabled' THEN NG_UiText:="Standalone: edit devices and points → save to draft → review and activate.";
END_IF;
RETURN;
END_IF;
IF Value='CONNECTED' THEN NG_UiText:="已连接";
ELSIF Value='CONNECTING' THEN NG_UiText:="正在连接";
ELSIF Value='ONLINE' THEN NG_UiText:="在线";
ELSIF Value='OFFLINE' THEN NG_UiText:="离线";
ELSIF Value='DEGRADED' THEN NG_UiText:="部分异常";
ELSIF Value='DISABLED' THEN NG_UiText:="已停用";
ELSIF Value='UNCONFIGURED' THEN NG_UiText:="未配置";
ELSIF Value='DRAFT' THEN NG_UiText:="待生效";
ELSIF Value='GOOD' THEN NG_UiText:="正常";
ELSIF Value='BAD' THEN NG_UiText:="异常";
ELSIF Value='STALE' THEN NG_UiText:="已过期";
ELSIF Value='UNKNOWN' THEN NG_UiText:="暂无数据";
ELSIF Value='BAD_COMMUNICATION' THEN NG_UiText:="通信异常";
ELSIF Value='BAD_CONFIGURATION' THEN NG_UiText:="配置有误";
ELSIF Value='true' THEN NG_UiText:="启用";
ELSIF Value='TRUE' THEN NG_UiText:="启用";
ELSIF Value='false' THEN NG_UiText:="停用";
ELSIF Value='FALSE' THEN NG_UiText:="停用";
ELSIF Value='PERSISTED' THEN NG_UiText:="已保存，无待生效修改";
ELSIF Value='UNSAVED DRAFT' THEN NG_UiText:="有待生效的修改";
ELSIF Value='VERSION CONFLICT' THEN NG_UiText:="配置已变更，请放弃旧草稿";
ELSIF Value='HUB_MANAGED' THEN NG_UiText:="平台统一管理";
ELSIF Value='STANDALONE' THEN NG_UiText:="本地独立管理";
ELSIF Value='HUB_MANAGED - local device/point changes blocked' THEN NG_UiText:="平台管理：在 Hub 编辑设备、点位与周期并发布；此处查看和维护连接。";
ELSIF Value='STANDALONE - local maintenance enabled' THEN NG_UiText:="本地管理：编辑设备和点位 → 保存到待生效配置 → 确认生效并保存。";
ELSIF Value='holding_register' THEN NG_UiText:="保持寄存器";
ELSIF Value='input_register' THEN NG_UiText:="输入寄存器";
ELSIF Value='coil' THEN NG_UiText:="线圈";
ELSIF Value='discrete_input' THEN NG_UiText:="离散输入";
ELSIF Value='cyclic' THEN NG_UiText:="定时上报";
ELSIF Value='change' THEN NG_UiText:="变化时上报";
ELSIF Value='change_or_cyclic' THEN NG_UiText:="变化或定时上报";
ELSIF Value='voltage' THEN NG_UiText:="电压";
ELSIF Value='current' THEN NG_UiText:="电流";
ELSIF Value='frequency' THEN NG_UiText:="频率";
ELSIF Value='power' THEN NG_UiText:="功率";
ELSIF Value='energy' THEN NG_UiText:="累计电能";
ELSIF Value='No device selected' THEN NG_UiText:="暂无设备，请先添加设备";
ELSIF Value='No point selected' THEN NG_UiText:="暂无点位，请先添加点位";
ELSIF Value='HUB_MANAGED: publish device and point changes from Hub.' THEN NG_UiText:="当前由平台管理，请在 Hub 修改并发布设备和点位配置。";
ELSIF Value='Display refreshed from active configuration. Unapplied draft discarded.' THEN NG_UiText:="已按当前运行配置更新显示，未生效的草稿已放弃。";
ELSIF Value='Loaded persisted active configuration.' THEN NG_UiText:="已按控制器当前运行配置更新显示。";
ELSIF Value='Capacity reached: 50 devices.' THEN NG_UiText:="设备数量已达上限：50 台。";
ELSIF Value='Capacity reached: 32 points/device, 320 shared points.' THEN NG_UiText:="点位数量已达上限：每台 32 个，总计 320 个。";
ELSIF Value='New device: save into draft, then add its points.' THEN NG_UiText:="填写连接参数并保存设备，再为该设备添加点位。";
ELSIF Value='Save a device into the draft first.' THEN NG_UiText:="请先保存设备，再添加该设备的点位。";
ELSIF Value='New point: save into draft, then apply the complete draft.' THEN NG_UiText:="填写寄存器与周期，保存点位后再确认配置生效。";
ELSIF Value='Busy: configuration transaction in progress. Try again shortly.' THEN NG_UiText:="正在保存配置，请稍候再试。";
ELSIF Value='Device index 1..50; point index 1..32.' THEN NG_UiText:="请检查设备序号（1～50）和点位序号（1～32）。";
ELSIF Value='Invalid device fields: check ID, name, IPv4, port and timeout values.' THEN NG_UiText:="设备未保存：检查唯一标识、名称、地址、端口与超时。";
ELSIF Value='Device saved to draft. Apply draft to persist.' THEN NG_UiText:="设备已加入待生效配置。检查点位后，点击“使配置生效”。";
ELSIF Value='Invalid point fields; save the device first and check numeric fields.' THEN NG_UiText:="点位未保存：先保存设备，再检查地址、周期、倍率等数值。";
ELSIF Value='Point saved to draft. Apply draft to persist.' THEN NG_UiText:="点位已加入待生效配置。点击“使配置生效”后开始使用。";
ELSIF Value='Device and points removed from draft. Apply to persist.' THEN NG_UiText:="设备及其点位已从草稿移除，确认配置生效后才停止采集。";
ELSIF Value='Point removed from draft. Apply to persist.' THEN NG_UiText:="点位已从草稿移除，确认配置生效后才停止采集。";
ELSIF Value='Invalid device polling/report period.' THEN NG_UiText:="周期未修改：采集与上报周期必须为有效的毫秒数。";
ELSIF Value='Device point periods updated in draft. Apply to persist.' THEN NG_UiText:="该设备的点位周期已加入待生效配置，请确认生效。";
ELSIF Value='VERSION_CONFLICT: reload active configuration before applying.' THEN NG_UiText:="运行配置已有更新。请放弃旧草稿，按最新配置重新编辑。";
ELSIF Value='Invalid gateway batch settings.' THEN NG_UiText:="请检查组批周期与每包点数（1～64）。";
ELSIF Value='Saving, hashing and reading back configuration...' THEN NG_UiText:="正在保存并校验配置，请稍候。";
ELSIF Value='Check broker/mode/ID. Mode change requires a new Gateway ID to isolate configuration history.' THEN NG_UiText:="连接未保存：检查地址、网关标识、客户端标识与模式；换模式须换网关标识。";
ELSIF Value='Saving broker settings...' THEN NG_UiText:="正在保存消息服务器连接设置，请稍候。";
ELSIF Value='APPLIED: configuration saved and activated.' THEN NG_UiText:="配置已生效并保存；重启后将自动恢复。";
ELSIF Value='Broker/mode saved; identity changes reset local baseline.' THEN NG_UiText:="连接设置已保存，正在自动重连；新身份需由平台重新下发配置。";
ELSIF Value='Startup identity persisted; MQTT starting.' THEN NG_UiText:="已自动恢复保存的配置，无需重复保存。";
ELSIF Value='Persisting unique startup identity before MQTT...' THEN NG_UiText:="正在保存启动信息，随后自动连接消息服务器。";
ELSIF Value='STORAGE_ERROR: active configuration unchanged.' THEN NG_UiText:="保存失败，运行配置保持原样。请检查控制器存储。";
ELSIF Value='Saving / validating durable file...' THEN NG_UiText:="正在写入并校验控制器配置文件……";
ELSIF Value='STORAGE ERROR: configuration not committed.' THEN NG_UiText:="配置保存失败，请检查控制器存储。";
ELSIF Value='Restoring saved configuration...' THEN NG_UiText:="正在恢复已保存配置，随后自动连接并采集。";
ELSIF Value='Broker unavailable. Retrying automatically; local acquisition continues.' THEN NG_UiText:="消息服务器暂不可用，正在自动重连；本地采集继续运行。";
ELSIF Value='MQTT_DISCONNECTED' THEN NG_UiText:="连接中断，自动重连中";
ELSIF Value='MQTT_CONNECT_ERROR' THEN NG_UiText:="连接失败，自动重试中";
ELSIF Value='MQTT_TIMEOUT' THEN NG_UiText:="连接超时，自动重试中";
ELSIF Value='MQTT_PUBLISH_ERROR' THEN NG_UiText:="发送失败，自动重连中";
ELSIF Value='MQTT_CLIENT_ERROR' THEN NG_UiText:="通信组件异常，自动重试中";
ELSIF Value='MQTT_SUBSCRIBE_ERROR' THEN NG_UiText:="订阅失败，自动重试中";
ELSIF Value='MQTT_CONSUME_ERROR' THEN NG_UiText:="接收失败，自动重试中";
ELSIF Value='SCHEMA_INVALID' THEN NG_UiText:="配置格式或取值不正确，请检查点位详情。";
ELSIF Value='DUPLICATE_DEVICE_ID' THEN NG_UiText:="设备标识重复，请使用唯一标识。";
ELSIF Value='DUPLICATE_POINT_ID' THEN NG_UiText:="同一设备内点位标识重复。";
ELSIF Value='INVALID_STALE_INTERVAL' THEN NG_UiText:="过期时间必须不小于采集周期。";
ELSIF Value='INVALID_ADDRESS' THEN NG_UiText:="寄存器地址范围无效。";
ELSIF Value='BAD_CONNECTION' THEN NG_UiText:="连接异常";
ELSIF Value='BAD_TIMEOUT' THEN NG_UiText:="请求超时";
ELSIF Value='BAD_PROTOCOL' THEN NG_UiText:="报文异常";
ELSIF Value='BAD_DECODE' THEN NG_UiText:="数据解码异常";
END_IF;
END_FUNCTION
