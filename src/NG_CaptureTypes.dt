(* P01/P02: volatile only. Do not add these types to NG_Durable/NG_File.
   All references are (slot,generation); generation exhaustion fails closed. *)
TYPE
    NG_CaptureEvent : STRUCT
        SampleSeq : ULINT;
        Value : LREAL;
        CapturedUtcMs : ULINT; (* Flags bit 0 present, bit 1 trusted, bit 3 SYSTEM_RTC; never backfilled *)
        CompletedMonoMs : ULINT;
        NominalDueMonoMs : ULINT; (* absent for QUALITY_STATE, Flags bit 2 *)
        ClockRevision : ULINT;
        SamplingGeneration : ULINT;
        ConfigGeneration : UDINT;
        ConfigSlot : UINT;
        PointIndex : UINT;
        Quality : USINT; (* 1 UNKNOWN,2 GOOD,3 STALE,4 CONNECTION,5 TIMEOUT,6 PROTOCOL,7 DECODE *)
        Kind : USINT; (* 1 PHYSICAL_RESULT,2 QUALITY_STATE *)
        Flags : WORD;
        PollSkippedBefore : UDINT; (* audit v2: consumes existing 4-byte tail padding; event stays 72 B *)
    END_STRUCT;
    NG_CaptureConfig : STRUCT
        Config : NG_Config;
        PointDevices : ARRAY[1..320] OF USINT; (* derived cache, lifetime fenced by this config generation *)
        GatewayId : NG_Id;
        CaptureBootId : NG_Id;
        Generation : UDINT;
        References : UDINT;
        Reserved : BOOL;
    END_STRUCT;
    NG_SourceCursor : STRUCT
        Generation : ULINT;
        ActivatedMonoMs : ULINT;
        LastPhysicalMonoMs : ULINT;
        NextDueMonoMs : ULINT;
        LastPhysicalUtcMs : ULINT;
        Quality : USINT;
        Enabled : BOOL;
        HasPhysical : BOOL;
        HasPhysicalUtc : BOOL;
        PollSkippedPending : UDINT; (* existing cursor tail padding; reset after physical capture *)
    END_STRUCT;
    NG_CaptureGap : STRUCT
        SampleSeq : ULINT;
        ConfigVersion : ULINT;
        CompletedMonoMs : ULINT;
        CapturedUtcMs : ULINT;
        Flags : WORD;
        Outcome : USINT; (* 2 known unsent,3 isolated,4 uncertain,5 undecided *)
        GatewayId : NG_Id;
        CaptureBootId : NG_Id;
        DeviceId : NG_Id;
        PointId : NG_Id;
        Reason : USINT; (* 1 CAPTURE_OVERFLOW,2 VERSION_DISCARD,3 identity/sequence exhausted *)
    END_STRUCT;
    NG_ReportCursor : STRUCT
        SamplingGeneration : ULINT;
        ClockRevision : ULINT;
        ConfigGeneration : UDINT;
        LastSeq : ULINT;
        NextDue : ULINT;
        Value : LREAL;
        Quality : USINT;
        HasBaseline : BOOL;
        TimePresent : BOOL;
    END_STRUCT;
    NG_BatchOwner : STRUCT
        OrderSeq : ULINT;
        CreatedMs : ULINT;
        TerminalMs : ULINT;
        Digest : STRING[64];
        Count : UINT;
        ConfigSlot : UINT;
        Category : USINT; (* 1 history,2 new *)
        State : USINT; (* 0 free,1 preparing,2 frozen,3 isolated *)
    END_STRUCT;
    NG_TerminalOwner : STRUCT
        MessageId : NG_Id;
        Digest : STRING[64];
        BatchGeneration : UDINT;
        Count : UINT;
        Outcome : USINT; (* 1 uncertain,2 isolated; 3 reconciled STORED *)
        FirstSeq : ULINT;
        CreatedMs : ULINT;
    END_STRUCT;
    NG_AuditEvent : STRUCT
        Event : NG_CaptureEvent;
        Decision : USINT; (* 0 pending,1 filtered,2 admitted,3 known-unsent,4 undecided-lost *)
        Reason : USINT;
        DecisionFlags : BYTE; (* bit0 facts,1 platform,2 valid,3 delay exact,4 revision exact,5 report exact,6 quality-epoch offset *)
        DecisionRevisionDelta : USINT; (* decision revision minus Event.ClockRevision, 0..255 *)
        DecisionDelayLo : UINT; (* snapshot mono minus completed mono, unsigned 24-bit milliseconds *)
        DecisionDelayHi : USINT;
        ReportSkipped : USINT; (* 0..254 physical report gaps; bit6: signed quality epoch slot offset+127; 255 unknown *)
    END_STRUCT;
    NG_Association : STRUCT
        Ordinal : ULINT;
        MessageId : NG_Id;
        Digest : STRING[64];
        SampleSeqs : ARRAY[1..64] OF ULINT;
        Count : UINT;
        ConfigSlot : UINT;
        ConfigGeneration : UDINT;
        BatchGeneration : UDINT;
        Category : USINT;
    END_STRUCT;
    NG_DiagnosticSnapshot : STRUCT
        Revision : ULINT;
        BootId : NG_Id;
        GatewayId : NG_Id;
        CapturedMonoMs : ULINT;
        ConfigVersion : ULINT;
        Totals : ARRAY[1..16] OF ULINT; (* P0/2 dictionary order *)
        DecisionPending : ULINT;
        PendingEvents : ULINT;
        DeadEvents : ULINT;
        UncertainRetainedEvents : ULINT;
        PendingBatches : UINT;
        DeadBatches : UINT;
        UsedBytes : UDINT;
        AllocatedBytes : UDINT;
        MaxBytes : UDINT := 4194304;
        OldestPendingAgeMs : ULINT;
        HasPendingAge : BOOL;
        AccountingComplete : BOOL;
        CounterOverflow : BOOL;
        DetailTruncated : BOOL;
        RestartLossUnknown : BOOL;
        AuditDropped : ULINT;
        AssociationDropped : ULINT;
        EvidenceComplete : BOOL;
        LastGap : NG_CaptureGap;
        LastGapCountKnown : BOOL;
        HmiSummary : STRING[256];
    END_STRUCT;
    NG_Buffer : STRUCT
        PlatformTime : BOOL;
        TimeValid : BOOL;
        ClockRevision : ULINT;
        Records : ARRAY[1..28800] OF NG_CaptureEvent; (* P03 admitted FIFO pool; actual quota, not 32768 nominal *)
        FreeSlots : ARRAY[1..28800] OF UINT;
        RecordGenerations : ARRAY[1..28800] OF UDINT;
        RecordStates : ARRAY[1..28800] OF USINT;
        Ingress : ARRAY[1..512] OF NG_CaptureEvent;
        Configs : ARRAY[1..4] OF NG_CaptureConfig;
        Cursors : ARRAY[1..320] OF NG_SourceCursor;
        Gaps : ARRAY[1..64] OF NG_CaptureGap;
        (* P04 reserves bounded event references and generation-fenced batch/tombstones. *)
        BatchRefs : ARRAY[1..1024] OF UINT; (* (batchSlot-1)*64+valueIndex *)
        BatchRefGenerations : ARRAY[1..1024] OF UDINT;
        BatchGenerations : ARRAY[1..16] OF UDINT;
        TombstoneGenerations : ARRAY[1..64] OF UDINT;
        TombstoneIds : ARRAY[1..64] OF NG_Id;
        ReportCursors : ARRAY[1..320] OF NG_ReportCursor;
        BatchOwners : ARRAY[1..16] OF NG_BatchOwner;
        TerminalOwners : ARRAY[1..64] OF NG_TerminalOwner;
        TerminalRefs : ARRAY[1..4096] OF UINT;
        TerminalRefGenerations : ARRAY[1..4096] OF UDINT;
        QueueHead : ARRAY[1..2] OF UINT;
        QueueTail : ARRAY[1..2] OF UINT;
        FreeHead : UINT;
        HighSlot : UINT;
        OwnedCount : UDINT;
        Watermark : ULINT;
        LastAdmittedSeq : ULINT;
        GateWasOpen : BOOL;
        PreferMaterialize : USINT := 1;
        PreferSend : USINT := 1;
        NextSendAt : ULINT;
        (* Internal cooperative CPU budget, monotonic microseconds; zero disables in golden fixtures. *)
        WorkDeadlineUs : ULINT;
        SourceWorkUs : ULINT;
        PipelineMarkUs : ULINT;
        WorkLastUs : ULINT;
        WorkMaxUs : ULINT;
        WorkTurn : BOOL;
        ConnectBudget : USINT;
        PollStartBudget : USINT;
        SourceSweepGeneration : ULINT;
        SourceSweepEnabled : BOOL;
        StaleCheckAt : ULINT;
        SourceStaleDue : ARRAY[1..320] OF ULINT; (* 0: disabled or already STALE *)
        TerminalIndex : UINT;
        EligibleEventsTotal : ULINT;
        PolicyFilteredEventsTotal : ULINT;
        TimeInvalidEventsTotal : ULINT;
        KnownUnsentEventsTotal : ULINT;
        IsolatedEventsTotal : ULINT;
        UncertainDeliveryEventsTotal : ULINT;
        StoredConfirmedEventsTotal : ULINT;
        StoredBatchesTotal : ULINT;
        LateStoredEventsTotal : ULINT;
        EnqueueRejectedAttemptsTotal : ULINT;
        MissedReportSlotsTotal : ULINT;
        GapRecordsTotal : ULINT;
        DeadPrunedBatchesTotal : ULINT;
        TombstonePrunedBatchesTotal : ULINT;
        UnknownAcksTotal : ULINT;
        ConflictingAcksTotal : ULINT;
        CorruptBatchesTotal : ULINT;
        Scratch : NG_CaptureEvent;
        Head : UINT := 1;
        Tail : UINT := 1;
        IngressCount : UINT;
        ActiveSlot : UINT;
        NextConfigGeneration : UDINT;
        SamplingGeneration : ULINT;
        NextSampleSeq : ULINT;
        CapturedEventsTotal : ULINT;
        CaptureOverflowEventsTotal : ULINT;
        UndecidedLostEventsTotal : ULINT;
        MissedPollCyclesTotal : ULINT;
        SourceTimestampRepeatTotal : ULINT;
        CancelledReadsTotal : ULINT;
        GapIndex : UINT;
        DetailTruncated : BOOL;
        CounterOverflow : BOOL;
        AccountingComplete : BOOL := TRUE;
        CaptureStopped : BOOL;
        CancellationReason : USINT; (* 2 VERSION_DISCARD; no completed point event is invented *)
        LayoutValid : BOOL;
        LayoutBytes : UDINT;
        RecordBytes : UDINT;
        AuditEvents : ARRAY[1..512] OF NG_AuditEvent;
        AuditEnabled : BOOL;
        AuditWriteSeq : ULINT;
        AuditReadSeq : ULINT;
        AuditAckSeq : ULINT; (* external recorder writes only after durable append *)
        AuditAckBootId : NG_Id;
        AuditDropped : ULINT;
        Associations : ARRAY[1..32] OF NG_Association;
        AssociationWriteSeq : ULINT;
        AssociationReadSeq : ULINT;
        AssociationAckSeq : ULINT;
        AssociationAckBootId : NG_Id;
        AssociationDropped : ULINT;
        EvidenceComplete : BOOL := TRUE;
        AuditFactSchema : USINT := 2;
        AuditFactsComplete : BOOL := TRUE; (* separate from raw ring completeness and business accounting *)
        DecisionSnapshotMonoMs : ULINT; (* same logical-clock frame as TimeValid/ClockRevision *)
        DeadRetainedEvents : ULINT;
        UncertainRetainedEvents : ULINT;
        RestartLossUnknown : BOOL := TRUE;
        DiagnosticInitialized : BOOL;
        Diagnostics : NG_DiagnosticSnapshot;
    END_STRUCT;
END_TYPE
