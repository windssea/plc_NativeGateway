FUNCTION NG_WireCode : NG_Text
VAR_INPUT
    Code : NG_Text;
    IsPatch : BOOL;
END_VAR
IF FIND('|SCHEMA_INVALID|INVALID_JSON|PAYLOAD_TOO_LARGE|GATEWAY_MISMATCH|DUPLICATE_DEVICE_ID|DUPLICATE_POINT_ID|DUPLICATE_NODE_ID|INVALID_ADDRESS|INVALID_STALE_INTERVAL|POINT_LIMIT_EXCEEDED|VERSION_CONFLICT|STALE_VERSION|RESOURCE_LIMIT|STORAGE_ERROR|APPLY_FAILED|UNKNOWN_CONFIG_VERSION|UNKNOWN_DEVICE|UNKNOWN_POINT|EXPIRED_DATA|INVALID_TIMESTAMP|DUPLICATE_VALUE|',CONCAT('|',Code,'|')) > 0 THEN NG_WireCode := Code;
ELSIF IsPatch AND (Code = 'RETAINED_PATCH') THEN NG_WireCode := 'OPERATION_CONFLICT';
ELSIF IsPatch AND (FIND('|BASE_CONFIG_MISMATCH|DEVICE_EXISTS|DEVICE_NOT_FOUND|OPERATION_CONFLICT|',CONCAT('|',Code,'|'))>0) THEN NG_WireCode := Code;
ELSE NG_WireCode := 'APPLY_FAILED';
END_IF;
END_FUNCTION
