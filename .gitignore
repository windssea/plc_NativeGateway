# Local environments, caches and generated output
.venv/
/.venv-validation/
venv/
__pycache__/
*.py[cod]
*.class
*.log
*.jsonl
*.db
*.db-*
*.sqlite*
*.pid
.env
.env.*
!.env.example
*.pem
*.key
/tmp/
/output/

# Vendor distributions and historical project backups stay on this workstation.
/reference/*
!/reference/README.md
!/reference/NativeGateway.before-implementation.pcwex
!/reference/NativeGateway.logo-import.pcwex
!/reference/NativeGateway.DataList.dl
!/reference/hmi-logo-template.xml
!/reference/HMI-Datum.xml
/NATIVE-GATEWAY.txt

# Test programs and reproducible fixtures; exclude live evidence, venv, databases,
# generated snapshots and numbered, one-off browser automation transcripts.
/tests/*
!/tests/*.py
!/tests/*.java
!/tests/config*.json
!/tests/expected*.json
!/tests/mock*.json
!/tests/mock*.yaml
!/tests/README.md
!/tests/phase1_capture_test.st
!/tests/phase1_pipeline_test.st
!/tests/phase1_pipeline_slice_checks.st
!/tests/phase1_diagnostics_test.st
!/tests/phase1_performance_test.st
!/tests/validation/

# Raw P05/P06 wire and expanded per-value mappings remain local; compact
# cohort/DB proofs and the SHA-256 evidence manifest are reviewable in Git.
/tests/validation/p05-p06/*wire*.json
/tests/validation/p05-p06/*.mapping.json
/tests/validation/p05-p06/batch64/*-boot*.jsonl
/tests/validation/p05-p06/batch64/wire-*.json
/tests/validation/p05-p06/batch64/cohort-*.mapping.json
/tests/validation/p05-p06/ablation/*-boot*.jsonl
/tests/validation/p05-p06/ablation/wire-*.json
/tests/validation/p05-p06/ablation/cohort-*.mapping.json

