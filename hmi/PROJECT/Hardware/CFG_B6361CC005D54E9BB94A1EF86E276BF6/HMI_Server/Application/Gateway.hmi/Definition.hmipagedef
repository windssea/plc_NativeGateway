        <HmiObject xsi:type="HmiText" Rotation="0" ID="NG4_436" IsTabSelectable="false" TabOrder="436" LineColor="#FFD3DEDA" LineWidth="0" Text="若已有平台备份：恢复进入维护前最后生效的平台设备、点位和周期。&#10;本地生效修改与未生效草稿会放弃；网关标识不变，不清空平台点表。&#10;若没有平台备份：保留本地采集，等待平台首次发布建立基线。" FontFamily="Microsoft YaHei" FontSize="22" FontStyle="normal" FontWeight="400" FontColor="#FF202629" IsTextWrapping="false" TextDirection="LeftToRight" HorizontalTextAlignment="Left" GuiStyle="Flat" TextMarginTop="0" TextMarginBottom="0" TextMarginLeft="0" TextMarginRight="0" EndCapType="Square" TextWrapping="WrapWithOverflow">
